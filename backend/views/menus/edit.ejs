<%- include("../partials/header") %>

<a
  href="/menus/<%= encodeURIComponent(menuItemId) %>"
  class="btn btn-outline-secondary mb-4"
>
  Back to menu item
</a>

<h1 class="h2">Edit menu item</h1>

<p class="text-secondary">
  Category and baseline-portion changes also update linked variants.
  Prices, status and dietary flags below apply to the parent item.
</p>

<% if (errorMessage) { %>
  <div class="alert alert-danger" role="alert">
    <%= errorMessage %>
  </div>
<% } %>

<form
  action="/menus/<%= encodeURIComponent(menuItemId) %>/edit"
  method="post"
  class="card"
>
  <input type="hidden" name="revision" value="<%= revision %>" />

  <div class="card-body p-4">
    <div class="row g-3">
      <% for (const field of fields) { %>
        <div class="col-md-6">
          <label for="<%= field.name %>" class="form-label">
            <%= field.label %>
          </label>

          <% if (field.type === "boolean") { %>
            <select
              id="<%= field.name %>"
              name="<%= field.name %>"
              class="form-select"
              <%= field.required ? "required" : "" %>
            >
              <% if (!field.required) { %>
                <option value="" <%= values[field.name] === "" ? "selected" : "" %>>
                  Unknown
                </option>
              <% } %>

              <option value="true" <%= values[field.name] === "true" ? "selected" : "" %>>
                Yes
              </option>

              <option value="false" <%= values[field.name] === "false" ? "selected" : "" %>>
                No
              </option>
            </select>
          <% } else if (field.type === "money" || field.type === "integer") { %>
            <input
              id="<%= field.name %>"
              name="<%= field.name %>"
              type="number"
              min="0"
              step="<%= field.type === 'integer' ? '1' : 'any' %>"
              class="form-control"
              value="<%= values[field.name] %>"
            />
          <% } else { %>
            <input
              id="<%= field.name %>"
              name="<%= field.name %>"
              type="text"
              class="form-control"
              maxlength="<%= field.maximumLength %>"
              value="<%= values[field.name] %>"
              <%= field.required ? "required" : "" %>
            />
          <% } %>
        </div>
      <% } %>
    </div>

    <p class="small text-secondary mt-4">
      Leave optional amounts blank when unknown. Only set dietary flags
      when verified. Original imported tag codes are retained separately.
    </p>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-dark">Save changes</button>

      <a
        href="/menus/<%= encodeURIComponent(menuItemId) %>"
        class="btn btn-outline-secondary"
      >
        Cancel
      </a>
    </div>
  </div>
</form>

<%- include("../partials/footer") %>