<%- include("../partials/header") %>

<div class="mb-4">
  <h1 class="h2">Menu items</h1>
  <p class="text-secondary">
    Parent dishes and their small and large prices.
  </p>
</div>

<div class="mb-4">
  <a href="/menus/new" class="btn btn-dark">Add menu item</a>
</div>

<form action="/menus" method="get" class="row g-3 align-items-end mb-4">
  <div class="col-sm-5 col-md-3">
    <label for="active" class="form-label">Status</label>

    <select id="active" name="active" class="form-select">
      <option value="all" <%= activeFilter === "all" ? "selected" : "" %>>
        All items
      </option>

      <option value="true" <%= activeFilter === "true" ? "selected" : "" %>>
        Active
      </option>

      <option value="false" <%= activeFilter === "false" ? "selected" : "" %>>
        Inactive
      </option>
    </select>
  </div>

  <input type="hidden" name="pageSize" value="<%= pagination.pageSize %>" />

  <div class="col-auto">
    <button type="submit" class="btn btn-dark">Apply filter</button>
  </div>
</form>

<p class="text-secondary">
  <%= pagination.totalRecords %>
  <%= pagination.totalRecords === 1 ? "item" : "items" %>
  matching this filter
</p>

<% if (items.length > 0) { %>
  <div class="table-responsive bg-white border rounded">
    <table class="table table-striped align-middle mb-0">
      <caption class="visually-hidden">
        Menu items matching the selected status filter
      </caption>

      <thead>
        <tr>
          <th scope="col">Item ID</th>
          <th scope="col">Name</th>
          <th scope="col">Category</th>
          <th scope="col" class="text-end">Small price</th>
          <th scope="col" class="text-end">Large price</th>
          <th scope="col">Status</th>
        </tr>
      </thead>

      <tbody>
        <% for (const item of items) { %>
          <tr>
            <td><%= item.menu_item_id %></td>
            <th scope="row">
  <a href="/menus/<%= encodeURIComponent(item.menu_item_id) %>">
    <%= item.name %>
  </a>
</th>
            <td><%= item.category %></td>
            <td class="text-end"><%= item.smallPrice %></td>
            <td class="text-end"><%= item.largePrice %></td>
            <td>
              <span class="badge <%= item.active ? 'text-bg-success' : 'text-bg-secondary' %>">
                <%= item.active ? "Active" : "Inactive" %>
              </span>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } else if (pagination.totalRecords === 0) { %>
  <div class="alert alert-secondary">
    No menu items match this filter.
    Import your menu data or choose another status.
  </div>
<% } else { %>
  <div class="alert alert-secondary">
    This page has no items.
    <a href="<%= firstPageUrl %>" class="alert-link">Go to the first page</a>.
  </div>
<% } %>

<% if (pagination.totalPages > 0) { %>
  <nav aria-label="Menu list pages" class="mt-4">
    <ul class="pagination">
      <li class="page-item <%= previousPageUrl ? '' : 'disabled' %>">
        <% if (previousPageUrl) { %>
          <a class="page-link" href="<%= previousPageUrl %>">Previous</a>
        <% } else { %>
          <span class="page-link">Previous</span>
        <% } %>
      </li>

      <li class="page-item">
        <span class="page-link text-body">
          Page <%= pagination.page %> of <%= pagination.totalPages %>
        </span>
      </li>

      <li class="page-item <%= nextPageUrl ? '' : 'disabled' %>">
        <% if (nextPageUrl) { %>
          <a class="page-link" href="<%= nextPageUrl %>">Next</a>
        <% } else { %>
          <span class="page-link">Next</span>
        <% } %>
      </li>
    </ul>
  </nav>
<% } %>

<%- include("../partials/footer") %>