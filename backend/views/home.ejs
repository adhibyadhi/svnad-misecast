<%- include("partials/header") %>

<section aria-labelledby="welcome-heading">
  <div class="bg-white border rounded-3 p-4 p-md-5">
    <p class="text-secondary mb-2">Restaurant planning</p>

    <h1 id="welcome-heading" class="display-5 fw-semibold">
      Welcome to MiseCast
    </h1>

    <p class="lead text-secondary mb-0">
      Understand your sales, anticipate demand and plan your inventory.
    </p>
  </div>

  <div class="row g-4 mt-2">
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="h5 card-title">Sales tracking</h2>
          <p class="card-text">Explore sales by date, menu item and service.</p>
          <span class="badge text-bg-secondary">Coming soon</span>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="h5 card-title">Demand forecasts</h2>
          <p class="card-text">
            Plan ahead with predictions for upcoming services.
          </p>
          <span class="badge text-bg-secondary">Coming soon</span>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body">
          <h2 class="h5 card-title">Inventory planning</h2>
          <p class="card-text">
            Review stock needs, expiry risks and ordering suggestions.
          </p>
          <span class="badge text-bg-secondary">Coming soon</span>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
