</script>



<!-- ==================================== -->
<!-- DASHBOARD JAVASCRIPT -->
<!-- ==================================== -->

<script>

  (() => {

    /**
     * Default dashboard.
     *
     * This is used if data is missing.
     */
    const defaultDashboard = {

      today: null,

      periods: {},

      forecast: {
        revenue: 0,
        portions: 0,
        days: 0,
        startDate: null,
        endDate: null,
      },
    };


    /**
     * Safely convert a value to a number.
     */
    function safeNumber(value) {

      const number =
        Number(value);

      if (
        !Number.isFinite(number)
      ) {
        return 0;
      }

      return number;
    }


    /**
     * Get element safely.
     */
    function getElement(id) {

      return document.getElementById(id);
    }


    /**
     * Set text only if element exists.
     */
    function setText(
      id,
      value,
    ) {

      const element =
        getElement(id);

      if (!element) {
        return;
      }

      element.textContent =
        value;
    }


    /**
     * --------------------------------------------------
     * READ DASHBOARD JSON
     * --------------------------------------------------
     */

    let dashboard =
      defaultDashboard;


    const dashboardElement =
      getElement(
        "sales-dashboard-data",
      );


    if (
      dashboardElement
    ) {

      try {

        const raw =
          dashboardElement
            .textContent
            .trim();


        if (raw) {

          const parsed =
            JSON.parse(raw);


          if (
            parsed &&
            typeof parsed === "object"
          ) {

            dashboard = {

              ...defaultDashboard,

              ...parsed,

              periods:
                parsed.periods &&
                typeof parsed.periods === "object"
                  ? parsed.periods
                  : {},

              forecast: {

                ...defaultDashboard.forecast,

                ...(
                  parsed.forecast &&
                  typeof parsed.forecast === "object"
                    ? parsed.forecast
                    : {}
                ),
              },
            };
          }
        }

      } catch (error) {

        console.warn(
          "Could not read sales dashboard data.",
          error,
        );

        dashboard =
          defaultDashboard;
      }
    }


    /**
     * --------------------------------------------------
     * SAFE DATA
     * --------------------------------------------------
     */

    const salesData =
      dashboard.periods &&
      typeof dashboard.periods === "object"
        ? dashboard.periods
        : {};


    const forecast = {

      revenue:
        safeNumber(
          dashboard.forecast
            ?.revenue,
        ),

      portions:
        safeNumber(
          dashboard.forecast
            ?.portions,
        ),

      days:
        safeNumber(
          dashboard.forecast
            ?.days,
        ),

      startDate:
        dashboard.forecast
          ?.startDate ??
        null,

      endDate:
        dashboard.forecast
          ?.endDate ??
        null,
    };


    /**
     * --------------------------------------------------
     * FORMATTERS
     * --------------------------------------------------
     */

    const currency =
      new Intl.NumberFormat(
        "en-AU",
        {
          style: "currency",
          currency: "AUD",
          maximumFractionDigits: 0,
        },
      );


    const integer =
      new Intl.NumberFormat(
        "en-AU",
      );


    const longDate =
      new Intl.DateTimeFormat(
        "en-AU",
        {
          weekday: "long",
          day: "numeric",
          month: "long",
          year: "numeric",
        },
      );


    const rangeDate =
      new Intl.DateTimeFormat(
        "en-AU",
        {
          day: "numeric",
          month: "short",
          year: "numeric",
        },
      );


    /**
     * Donut colours.
     */
    const menuColours = [
      "#8b43df",
      "#f2b72f",
      "#ef5c3d",
      "#49ace0",
      "#238866",
    ];


    /**
     * --------------------------------------------------
     * DATE HELPERS
     * --------------------------------------------------
     */

    function parseDisplayDate(
      value,
    ) {

      if (!value) {
        return null;
      }


      const date =
        new Date(
          `${value}T12:00:00`,
        );


      if (
        Number.isNaN(
          date.getTime(),
        )
      ) {
        return null;
      }


      return date;
    }


    function displayRange(
      start,
      end,
    ) {

      const startDate =
        parseDisplayDate(
          start,
        );


      const endDate =
        parseDisplayDate(
          end,
        );


      if (
        !startDate ||
        !endDate
      ) {
        return "";
      }


      return (
        `${rangeDate.format(startDate)} – ` +
        `${rangeDate.format(endDate)}`
      );
    }


    /**
     * --------------------------------------------------
     * PERCENTAGE CHANGE
     * --------------------------------------------------
     */

    function percentageChange(
      currentValue,
      previousValue,
    ) {

      const current =
        safeNumber(
          currentValue,
        );


      const previous =
        safeNumber(
          previousValue,
        );


      if (
        previous === 0
      ) {

        if (
          current === 0
        ) {
          return 0;
        }

        return null;
      }


      return (
        (
          current -
          previous
        ) /
        previous
      ) *
        100;
    }


    function updateChange(
      element,
      value,
    ) {

      if (!element) {
        return;
      }


      element.classList.remove(
        "negative",
        "neutral",
      );


      if (
        value === null
      ) {

        element.textContent =
          "New";


        element.classList.add(
          "neutral",
        );

        return;
      }


      const number =
        safeNumber(
          value,
        );


      const positive =
        number >= 0;


      element.textContent =
        `${
          positive
            ? "↗"
            : "↘"
        } ${
          Math.abs(
            number,
          ).toFixed(1)
        }%`;


      element.classList.toggle(
        "negative",
        !positive,
      );
    }


    /**
     * --------------------------------------------------
     * SAFE PERIOD OBJECT
     * --------------------------------------------------
     */

    function normalisePeriod(
      value,
    ) {

      const data =
        value &&
        typeof value === "object"
          ? value
          : {};


      return {

        startDate:
          data.startDate ??
          null,

        endDate:
          data.endDate ??
          null,

        revenue:
          safeNumber(
            data.revenue,
          ),

        previousRevenue:
          safeNumber(
            data.previousRevenue,
          ),

        itemsSold:
          safeNumber(
            data.itemsSold,
          ),

        previousItemsSold:
          safeNumber(
            data.previousItemsSold,
          ),

        averageItemValue:
          safeNumber(
            data.averageItemValue,
          ),

        previousAverageItemValue:
          safeNumber(
            data.previousAverageItemValue,
          ),

        menuRevenue:
          Array.isArray(
            data.menuRevenue,
          )
            ? data.menuRevenue
            : [],
      };
    }


    /**
     * --------------------------------------------------
     * MENU REVENUE
     * --------------------------------------------------
     */

    function renderMenuRevenue(
      rawData,
    ) {

      const data =
        normalisePeriod(
          rawData,
        );


      const chart =
        getElement(
          "menu-revenue-chart",
        );


      const ranking =
        getElement(
          "menu-revenue-ranking",
        );


      const otherDetails =
        getElement(
          "menu-revenue-other",
        );


      const otherSummary =
        getElement(
          "menu-revenue-other-summary",
        );


      const otherList =
        getElement(
          "menu-revenue-other-list",
        );


      /**
       * Clear previous rendering.
       */
      if (
        ranking
      ) {
        ranking.replaceChildren();
      }


      if (
        otherList
      ) {
        otherList.replaceChildren();
      }


      /**
       * Total revenue.
       */
      setText(
        "menu-revenue-total",

        currency.format(
          data.revenue,
        ),
      );


      /**
       * No sales.
       */
      if (
        data.revenue <= 0 ||
        data.menuRevenue.length === 0
      ) {

        if (
          chart
        ) {
          chart.style.background =
            "#e4e9e6";
        }


        if (
          ranking
        ) {

          const empty =
            document.createElement(
              "div",
            );


          empty.className =
            "sales-empty";


          empty.textContent =
            "No sales data for this period.";


          ranking.append(
            empty,
          );
        }


        if (
          otherDetails
        ) {
          otherDetails.style.display =
            "none";
        }


        return;
      }


      if (
        otherDetails
      ) {
        otherDetails.style.display =
          "";
      }


      /**
       * Clean bad menu rows.
       */
      const validRows =
        data.menuRevenue
          .filter(
            (item) =>
              item &&
              typeof item === "object",
          )
          .map(
            (item) => ({

              name:
                item.name ??
                "Unknown menu item",

              revenue:
                safeNumber(
                  item.revenue,
                ),
            }),
          );


      /**
       * If everything was invalid,
       * show empty state.
       */
      if (
        validRows.length === 0
      ) {

        if (
          ranking
        ) {

          const empty =
            document.createElement(
              "div",
            );


          empty.className =
            "sales-empty";


          empty.textContent =
            "No sales data for this period.";


          ranking.append(
            empty,
          );
        }


        return;
      }


      const topItems =
        validRows.slice(
          0,
          5,
        );


      const otherItems =
        validRows.slice(
          5,
        );


      const otherRevenue =
        otherItems.reduce(
          (
            total,
            item,
          ) =>
            total +
            item.revenue,
          0,
        );


      /**
       * Chart data.
       */
      const chartItems = [
        ...topItems,
      ];


      if (
        otherRevenue > 0
      ) {

        chartItems.push({
          name:
            "Other menu items",

          revenue:
            otherRevenue,
        });
      }


      const chartColours = [
        ...menuColours,
        "#dfe5df",
      ];


      let position =
        0;


      const segments =
        chartItems.map(
          (
            item,
            index,
          ) => {

            const start =
              position;


            if (
              data.revenue > 0
            ) {

              position +=
                (
                  item.revenue /
                  data.revenue
                ) *
                360;
            }


            return (
              `${
                chartColours[index] ??
                "#dfe5df"
              } ` +
              `${start.toFixed(2)}deg ` +
              `${position.toFixed(2)}deg`
            );
          },
        );


      if (
        chart &&
        segments.length > 0
      ) {

        chart.style.background =
          `conic-gradient(
            from -90deg,
            ${segments.join(", ")}
          )`;
      }


      /**
       * Top 5 ranking.
       */
      if (
        ranking
      ) {

        topItems.forEach(
          (
            item,
            index,
          ) => {

            const row =
              document.createElement(
                "div",
              );


            row.className =
              "menu-revenue-row";


            const dot =
              document.createElement(
                "span",
              );


            dot.className =
              "menu-revenue-dot";


            dot.style.background =
              menuColours[index] ??
              "#dfe5df";


            const name =
              document.createElement(
                "span",
              );


            name.className =
              "menu-revenue-name";


            name.textContent =
              `${index + 1}. ${item.name}`;


            const value =
              document.createElement(
                "span",
              );


            value.className =
              "menu-revenue-value";


            const percentage =
              data.revenue > 0
                ? (
                    item.revenue /
                    data.revenue
                  ) *
                  100
                : 0;


            const strong =
              document.createElement(
                "strong",
              );


            strong.textContent =
              currency.format(
                item.revenue,
              );


            const percentageElement =
              document.createElement(
                "span",
              );


            percentageElement.textContent =
              `${safeNumber(
                percentage,
              ).toFixed(1)}%`;


            value.append(
              strong,
              percentageElement,
            );


            row.append(
              dot,
              name,
              value,
            );


            ranking.append(
              row,
            );
          },
        );
      }


      /**
       * Other menu items.
       */
      if (
        otherSummary
      ) {

        otherSummary.textContent =
          `Other ${
            otherItems.length
          } menu item${
            otherItems.length === 1
              ? ""
              : "s"
          } · ${
            currency.format(
              otherRevenue,
            )
          }`;
      }


      if (
        otherList
      ) {

        otherItems.forEach(
          (item) => {

            const row =
              document.createElement(
                "div",
              );


            row.className =
              "menu-revenue-other-item";


            const name =
              document.createElement(
                "span",
              );


            name.textContent =
              item.name;


            const value =
              document.createElement(
                "strong",
              );


            value.textContent =
              currency.format(
                item.revenue,
              );


            row.append(
              name,
              value,
            );


            otherList.append(
              row,
            );
          },
        );
      }
    }


    /**
     * --------------------------------------------------
     * RENDER SALES PERIOD
     * --------------------------------------------------
     */

    function render(
      period,
    ) {

      /**
       * Missing period becomes an
       * empty dashboard instead of crashing.
       */
      const data =
        normalisePeriod(
          salesData?.[period],
        );


      setText(
        "sales-total",

        currency.format(
          data.revenue,
        ),
      );


      setText(
        "sales-items",

        integer.format(
          data.itemsSold,
        ),
      );


      setText(
        "sales-average",

        currency.format(
          data.averageItemValue,
        ),
      );


      updateChange(
        getElement(
          "sales-change",
        ),

        percentageChange(
          data.revenue,
          data.previousRevenue,
        ),
      );


      updateChange(
        getElement(
          "items-change",
        ),

        percentageChange(
          data.itemsSold,
          data.previousItemsSold,
        ),
      );


      updateChange(
        getElement(
          "average-change",
        ),

        percentageChange(
          data.averageItemValue,
          data.previousAverageItemValue,
        ),
      );


      const range =
        displayRange(
          data.startDate,
          data.endDate,
        );


      setText(
        "sales-date-range",

        range
          ? `Showing ${range}`
          : "No sales data available",
      );


      setText(
        "dashboard-total-revenue",

        currency.format(
          data.revenue,
        ),
      );


      setText(
        "dashboard-total-caption",

        range ||
        "No sales data available",
      );


      renderMenuRevenue(
        data,
      );
    }


    /**
     * --------------------------------------------------
     * FORECAST
     * --------------------------------------------------
     */

    setText(
      "dashboard-sales-forecast",

      currency.format(
        forecast.revenue,
      ),
    );


    if (
      forecast.days > 0
    ) {

      const forecastRange =
        displayRange(
          forecast.startDate,
          forecast.endDate,
        );


      setText(
        "dashboard-forecast-caption",

        `${integer.format(
          forecast.days,
        )} saved future prediction${
          forecast.days === 1
            ? ""
            : "s"
        }${
          forecastRange
            ? ` · ${forecastRange}`
            : ""
        }`,
      );

    } else {

      setText(
        "dashboard-forecast-caption",
        "No saved future predictions",
      );
    }


    /**
     * --------------------------------------------------
     * PERIOD BUTTONS
     * --------------------------------------------------
     */

    document
      .querySelectorAll(
        "[data-sales-period]",
      )
      .forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              document
                .querySelectorAll(
                  "[data-sales-period]",
                )
                .forEach(
                  (candidate) => {

                    const active =
                      candidate ===
                      button;


                    candidate
                      .classList
                      .toggle(
                        "active",
                        active,
                      );


                    candidate
                      .setAttribute(
                        "aria-pressed",
                        String(active),
                      );
                  },
                );


              render(
                button.dataset
                  .salesPeriod ??
                "7",
              );
            },
          );
        },
      );


    /**
     * --------------------------------------------------
     * TODAY
     * --------------------------------------------------
     */

    const todayDate =
      parseDisplayDate(
        dashboard.today,
      );


    if (
      todayDate
    ) {

      setText(
        "sales-today-date",

        longDate.format(
          todayDate,
        ),
      );

    } else {

      setText(
        "sales-today-date",
        "Today",
      );
    }


    /**
     * --------------------------------------------------
     * DEFAULT PERIOD
     * --------------------------------------------------
     */

    render(
      "7",
    );

  })();

</script>


