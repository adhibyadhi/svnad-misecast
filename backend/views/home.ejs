<%- include("partials/header", { title: "Home" , pageTitle: "Home" }) %>

  <style>
    .sales-section {
      margin-block: 2.5rem;
    }

    .sales-demo-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border-radius: 999px;
      padding: 0.4rem 0.65rem;
      color: #75530b;
      background: #fff0c7;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .sales-period-switch {
      display: inline-flex;
      overflow: hidden;
      border: 1px solid var(--mc-border);
      border-radius: 0.7rem;
      background: #f4f6f4;
    }

    .sales-period-switch button {
      border: 0;
      padding: 0.55rem 0.85rem;
      color: var(--mc-muted);
      background: transparent;
      font-size: 0.78rem;
      font-weight: 700;
    }

    .sales-period-switch button.active {
      color: #fff;
      background: var(--mc-ink);
    }

    .sales-date-heading {
      margin: 0;
      color: var(--mc-ink);
      font-size: clamp(1.85rem, 4vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.055em;
      line-height: 1;
    }

    .sales-date-subtitle {
      margin-top: 0.55rem;
      color: var(--mc-muted);
      font-size: 0.86rem;
    }

    .sales-dashboard {
      overflow: hidden;
    }

    .sales-summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--mc-border);
    }

    .sales-summary {
      border-right: 1px solid var(--mc-border);
      padding: 1.25rem 1.4rem;
    }

    .sales-summary:last-child {
      border-right: 0;
    }

    .sales-summary-label {
      color: var(--mc-muted);
      font-size: 0.75rem;
      font-weight: 700;
    }

    .sales-summary-value {
      margin-top: 0.35rem;
      font-size: clamp(1.35rem, 2.5vw, 2rem);
      font-weight: 800;
      letter-spacing: -0.045em;
    }

    .sales-change {
      display: inline-flex;
      align-items: center;
      gap: 0.18rem;
      margin-top: 0.4rem;
      border-radius: 999px;
      padding: 0.25rem 0.45rem;
      color: #1c7651;
      background: #e4f4eb;
      font-size: 0.68rem;
      font-weight: 750;
    }

    .sales-change.negative {
      color: #a34444;
      background: #f9e8e6;
    }

    .sales-chart-wrap {
      padding: 1.2rem 1.4rem 1rem;
    }

    .sales-chart-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.8rem;
    }

    .sales-range {
      color: var(--mc-muted);
      font-size: 0.72rem;
      font-weight: 650;
    }

    .sales-chart-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
    }

    .sales-legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: var(--mc-muted);
      font-size: 0.7rem;
      font-weight: 650;
    }

    .sales-legend-line {
      width: 1.2rem;
      border-top: 2px solid var(--mc-green);
    }

    .sales-legend-line.previous {
      border-top-style: dashed;
      border-top-color: #aeb8b2;
    }

    .sales-chart {
      display: block;
      width: 100%;
      height: 15rem;
      overflow: visible;
    }

    .sales-grid-line {
      stroke: #e7ebe8;
      stroke-width: 1;
    }

    .sales-current-line {
      fill: none;
      stroke: var(--mc-green);
      stroke-width: 3;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .sales-previous-line {
      fill: none;
      stroke: #aeb8b2;
      stroke-width: 2;
      stroke-dasharray: 6 7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .sales-point {
      fill: #fff;
      stroke: var(--mc-green);
      stroke-width: 2;
    }

    .sales-axis-labels {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      margin-top: 0.2rem;
      color: var(--mc-muted);
      font-size: 0.67rem;
    }

    .sales-axis-labels span {
      flex: 1 1 0;
      min-width: 0;
      text-align: center;
      white-space: pre-line;
    }

    .sales-axis-labels span:first-child {
      text-align: left;
    }

    .sales-axis-labels span:last-child {
      text-align: right;
    }

    .sales-note {
      color: var(--mc-muted);
      font-size: 0.72rem;
    }

    .menu-revenue-layout {
      display: grid;
      grid-template-columns: minmax(15rem, 0.85fr) minmax(18rem, 1.15fr);
      gap: 2rem;
      align-items: center;
      padding-block: 0.75rem;
    }

    .menu-revenue-chart-shell {
      display: grid;
      place-items: center;
      min-height: 22rem;
    }

    .menu-revenue-chart {
      position: relative;
      display: grid;
      width: min(100%, 20rem);
      aspect-ratio: 1;
      place-items: center;
      border-radius: 50%;
      background: #e4e9e6;
      box-shadow: 0 20px 45px rgba(23, 35, 31, 0.12);
      transition: background 250ms ease;
    }

    .menu-revenue-chart::after {
      position: absolute;
      width: 61%;
      aspect-ratio: 1;
      border: 1px solid var(--mc-border);
      border-radius: 50%;
      background: #fffdfa;
      box-shadow: inset 0 3px 16px rgba(23, 35, 31, 0.05);
      content: "";
    }

    .menu-revenue-center {
      z-index: 1;
      display: grid;
      gap: 0.2rem;
      text-align: center;
    }

    .menu-revenue-center span {
      color: var(--mc-muted);
      font-size: 0.72rem;
      font-weight: 700;
    }

    .menu-revenue-center strong {
      color: var(--mc-ink);
      font-size: clamp(1.45rem, 3vw, 2.1rem);
      letter-spacing: -0.045em;
    }

    .menu-revenue-ranking {
      display: grid;
      gap: 0.65rem;
    }

    .menu-revenue-row {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.7rem;
      align-items: center;
      border: 1px solid var(--mc-border);
      border-radius: 0.8rem;
      padding: 0.75rem 0.9rem;
      background: #fff;
    }

    .menu-revenue-dot {
      width: 0.72rem;
      height: 0.72rem;
      border-radius: 50%;
    }

    .menu-revenue-name {
      overflow: hidden;
      font-size: 0.8rem;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .menu-revenue-value {
      text-align: right;
    }

    .menu-revenue-value strong {
      display: block;
      font-size: 0.82rem;
    }

    .menu-revenue-value span {
      color: var(--mc-muted);
      font-size: 0.68rem;
    }

    .menu-revenue-other {
      margin-top: 0.75rem;
      border: 1px solid var(--mc-border);
      border-radius: 0.8rem;
      background: #f7f9f7;
    }

    .menu-revenue-other summary {
      cursor: pointer;
      padding: 0.8rem 0.9rem;
      color: var(--mc-muted);
      font-size: 0.76rem;
      font-weight: 700;
    }

    .menu-revenue-other-list {
      display: grid;
      gap: 0.45rem;
      border-top: 1px solid var(--mc-border);
      padding: 0.75rem 0.9rem;
    }

    .menu-revenue-other-item {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      color: var(--mc-muted);
      font-size: 0.72rem;
    }

    .sales-kpi-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-top: 1rem;
    }

    .sales-kpi-card {
      min-height: 9.5rem;
      border: 1px solid var(--mc-border);
      border-radius: 1rem;
      padding: 1.2rem 1.3rem;
      background: #fff;
      box-shadow: 0 10px 30px rgba(23, 35, 31, 0.04);
    }

    .sales-kpi-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      color: var(--mc-muted);
      font-size: 0.78rem;
      font-weight: 700;
    }

    .sales-kpi-value {
      margin-top: 1.15rem;
      color: var(--mc-ink);
      font-size: clamp(1.55rem, 3vw, 2.25rem);
      font-weight: 800;
      letter-spacing: -0.045em;
    }

    .sales-kpi-caption {
      margin-top: 0.45rem;
      color: var(--mc-muted);
      font-size: 0.72rem;
    }

    .sales-coming-soon {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 0.28rem 0.5rem;
      color: #765d22;
      background: #fff2cc;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    @media (max-width: 767.98px) {
      .sales-summary-grid {
        grid-template-columns: 1fr;
      }

      .sales-summary {
        border-right: 0;
        border-bottom: 1px solid var(--mc-border);
      }

      .sales-summary:last-child {
        border-bottom: 0;
      }

      .sales-chart {
        height: 11rem;
      }

      .sales-kpi-grid {
        grid-template-columns: 1fr;
      }

      .sales-axis-labels {
        font-size: 0.58rem;
      }

      .menu-revenue-layout {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .menu-revenue-chart-shell {
        min-height: auto;
        padding-block: 1rem;
      }
    }
  </style>

