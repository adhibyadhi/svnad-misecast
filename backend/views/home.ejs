  <script>
    (() => {
      const salesData = {
        7: {
          current: [2940, 3180, 3060, 3520, 3890, 4310, 4680],
          previous: [2710, 2850, 3010, 3140, 3300, 3520, 3740],
          orders: [67, 72, 69, 79, 86, 94, 102],
          previousOrders: 511,
          forecast: 27850,
          note: "Simulated daily sales compared with the previous 7 days.",
        },
        30: {
          current: [2680, 2760, 2890, 3010, 2940, 3120, 3260, 3190, 3410, 3520, 3460, 3650, 3780, 3890, 3810, 3970, 4120, 4050, 4280, 4410, 4350, 4520, 4680, 4590, 4810, 4940, 4870, 5060, 5230, 5410],
          previous: [2510, 2580, 2670, 2740, 2710, 2810, 2890, 2950, 3020, 3090, 3060, 3160, 3230, 3290, 3260, 3360, 3440, 3510, 3480, 3590, 3670, 3740, 3710, 3820, 3890, 3970, 4030, 4110, 4180, 4260],
          orders: [61, 63, 66, 68, 67, 71, 73, 72, 77, 79, 78, 82, 84, 87, 85, 89, 92, 91, 96, 99, 97, 101, 104, 103, 108, 111, 109, 114, 117, 121],
          previousOrders: 2398,
          forecast: 129600,
          note: "Simulated daily sales compared with the previous 30 days.",
        },
        year: {
          current: [78400, 81200, 84900, 88100, 92400, 95800, 101600, 107200, 110400, 116800, 121900, 128500],
          previous: [72100, 74800, 77900, 80600, 84200, 87600, 92100, 96400, 99800, 103500, 108200, 112700],
          orders: [1760, 1815, 1890, 1955, 2040, 2110, 2220, 2330, 2400, 2520, 2625, 2750],
          previousOrders: 23280,
          forecast: 1329000,
          note: "Simulated monthly sales compared with the previous 12 months.",
        },
      };

      // Dummy values for now. Replace this array with actual model output later.
      const menuNames = [
        "Chicken Teriyaki Bowl",
        "Wagyu Beef Bowl",
        "Salmon Aburi Bowl",
        "Sashimi Poke Bowl",
        "Karaage Chicken Bowl",
        "Tofu Bowl",
        "Miso Falafel Bowl",
        "Bone Broth soup",
        "Yuzu tea",
        "Hot Chocolate",
        "Specialty Soda",
        "Coconut water",
        "Sparkling water",
        "Miso soup",
        "Still waterr",
      ];

      const menuWeights = [17, 13, 11, 10, 9, 7, 6, 5, 5, 4, 4, 3, 3, 2, 1];
      const topMenuColours = ["#8b43df", "#f2b72f", "#ef5c3d", "#49ace0", "#238866"];

      function buildMenuRevenue(totalRevenue) {
        let assignedRevenue = 0;

        return menuNames.map((name, index) => {
          const revenue = index === menuNames.length - 1
            ? totalRevenue - assignedRevenue
            : Math.round(totalRevenue * menuWeights[index] / 100);

          assignedRevenue += revenue;
          return { name, revenue };
        });
      }

      const currency = new Intl.NumberFormat("en-AU", {
        style: "currency",
        currency: "AUD",
        maximumFractionDigits: 0,
      });

      const integer = new Intl.NumberFormat("en-AU");
      const svgNamespace = "http://www.w3.org/2000/svg";
      const today = new Date();
      today.setHours(12, 0, 0, 0);

      const longDate = new Intl.DateTimeFormat("en-AU", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
      });

      const rangeDate = new Intl.DateTimeFormat("en-AU", {
        day: "numeric",
        month: "short",
        year: "numeric",
      });

      const shortDate = new Intl.DateTimeFormat("en-AU", {
        day: "numeric",
        month: "short",
      });

      const dayDate = new Intl.DateTimeFormat("en-AU", {
        weekday: "short",
        day: "numeric",
        month: "short",
      });

      function total(values) {
        return values.reduce((sum, value) => sum + value, 0);
      }

      function percentageChange(current, previous) {
        if (!previous) return 0;
        return (current - previous) / previous * 100;
      }

      function updateChange(element, value) {
        const positive = value >= 0;
        element.textContent = (positive ? "↗ " : "↘ ") + Math.abs(value).toFixed(1) + "%";
        element.classList.toggle("negative", !positive);
      }

      function chartPoints(values, minimum, maximum) {
        const width = 800;
        const top = 20;
        const bottom = 210;
        const range = Math.max(maximum - minimum, 1);
        return values.map((value, index) => {
          const x = values.length === 1 ? width / 2 : index / (values.length - 1) * width;
          const y = bottom - (value - minimum) / range * (bottom - top);
          return [x, y];
        });
      }

      function pointString(points) {
        return points.map((point) => point[0].toFixed(1) + "," + point[1].toFixed(1)).join(" ");
      }

      function dayOffset(offset) {
        const date = new Date(today);
        date.setDate(date.getDate() + offset);
        return date;
      }

      function periodDetails(period) {
        if (period === "year") {
          const start = new Date(today.getFullYear(), today.getMonth() - 11, 1, 12);
          return {
            start,
            end: today,
            points: salesData.year.current.map((value, index) => index),
            forecastCaption: "Projected next 12 months",
          };
        }

        const days = Number(period);
        const indexes = period === "7" ? [0, 1, 2, 3, 4, 5, 6] : [0, 5, 10, 15, 20, 25, 29];
        return {
          start: dayOffset(-(days - 1)),
          end: today,
          points: indexes,
          forecastCaption: "Projected next " + days + " days",
        };
      }

      function axisLabels(period, indexes) {
        if (period === "year") {
          return indexes.map((index) => {
            const date = new Date(today.getFullYear(), today.getMonth() - (11 - index), 1, 12);
            return date.toLocaleDateString("en-AU", { month: "short" });
          });
        }

        const days = Number(period);
        return indexes.map((index) => {
          const date = dayOffset(-(days - 1) + index);
          if (period === "7") {
            const pieces = dayDate.formatToParts(date);
            const weekday = pieces.find((piece) => piece.type === "weekday").value;
            const dateText = pieces
              .filter((piece) => piece.type === "day" || piece.type === "month")
              .map((piece) => piece.value)
              .join(" ");
            return weekday + "\n" + dateText;
          }
          return shortDate.format(date);
        });
      }

      function displayRange(start, end) {
        return rangeDate.format(start) + " – " + rangeDate.format(end);
      }

      function render(period) {
        const data = salesData[period];
        const details = periodDetails(period);
        const currentSales = total(data.current);
        const previousSales = total(data.previous);
        const currentOrders = total(data.orders);
        const currentAverage = currentSales / currentOrders;
        const previousAverage = previousSales / data.previousOrders;
        const periodRange = displayRange(details.start, details.end);

        document.getElementById("sales-total").textContent = currency.format(currentSales);
        document.getElementById("sales-orders").textContent = integer.format(currentOrders);
        document.getElementById("sales-average").textContent = currency.format(currentAverage);
        updateChange(document.getElementById("sales-change"), percentageChange(currentSales, previousSales));
        updateChange(document.getElementById("orders-change"), percentageChange(currentOrders, data.previousOrders));
        updateChange(document.getElementById("average-change"), percentageChange(currentAverage, previousAverage));
        document.getElementById("dashboard-total-revenue").textContent = currency.format(currentSales);
        document.getElementById("dashboard-total-caption").textContent = periodRange + " · simulated";
        document.getElementById("dashboard-sales-forecast").textContent = currency.format(data.forecast);
        document.getElementById("dashboard-forecast-caption").textContent = details.forecastCaption + " · simulated";
        document.getElementById("sales-date-range").textContent = "Showing " + periodRange;
        document.getElementById("sales-chart-range").textContent = periodRange;

        const revenueItems = buildMenuRevenue(currentSales)
          .sort((first, second) => second.revenue - first.revenue);
        const topItems = revenueItems.slice(0, 5);
        const otherItems = revenueItems.slice(5);
        const otherRevenue = total(otherItems.map((item) => item.revenue));
        const chartItems = topItems.concat({ name: "Other menu items", revenue: otherRevenue });
        let chartPosition = 0;
        const chartColours = topMenuColours.concat("#dfe5df");
        const chartSegments = chartItems.map((item, index) => {
          const start = chartPosition;
          chartPosition += item.revenue / currentSales * 360;
          return `${chartColours[index]} ${start.toFixed(2)}deg ${chartPosition.toFixed(2)}deg`;
        });

        const chart = document.getElementById("menu-revenue-chart");
        chart.style.background = `conic-gradient(from -90deg, ${chartSegments.join(", ")})`;
        chart.setAttribute(
          "aria-label",
          `Revenue contribution by menu. Top contributor: ${topItems[0].name}, ${currency.format(topItems[0].revenue)}.`,
        );
        document.getElementById("menu-revenue-total").textContent = currency.format(currentSales);

        const ranking = document.getElementById("menu-revenue-ranking");
        ranking.replaceChildren();
        topItems.forEach((item, index) => {
          const row = document.createElement("div");
          row.className = "menu-revenue-row";

          const dot = document.createElement("span");
          dot.className = "menu-revenue-dot";
          dot.style.background = topMenuColours[index];

          const name = document.createElement("span");
          name.className = "menu-revenue-name";
          name.textContent = `${index + 1}. ${item.name}`;

          const value = document.createElement("span");
          value.className = "menu-revenue-value";
          value.innerHTML = `<strong>${currency.format(item.revenue)}</strong><span>${(item.revenue / currentSales * 100).toFixed(1)}%</span>`;

          row.append(dot, name, value);
          ranking.append(row);
        });

        document.getElementById("menu-revenue-other-summary").textContent =
          `Other ${otherItems.length} menu items · ${currency.format(otherRevenue)}`;
        const otherList = document.getElementById("menu-revenue-other-list");
        otherList.replaceChildren();
        otherItems.forEach((item) => {
          const row = document.createElement("div");
          row.className = "menu-revenue-other-item";
          const name = document.createElement("span");
          name.textContent = item.name;
          const value = document.createElement("strong");
          value.textContent = currency.format(item.revenue);
          row.append(name, value);
          otherList.append(row);
        });
      }

      document.querySelectorAll("[data-sales-period]").forEach((button) => {
        button.addEventListener("click", () => {
          document.querySelectorAll("[data-sales-period]").forEach((candidate) => {
            const active = candidate === button;
            candidate.classList.toggle("active", active);
            candidate.setAttribute("aria-pressed", String(active));
          });
          render(button.dataset.salesPeriod);
        });
      });

      document.getElementById("sales-today-date").textContent = longDate.format(today);
      render("7");
    })();
  </script>

