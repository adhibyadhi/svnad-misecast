<%- include("../partials/header") %>

<h1 class="h2">Victorian public holidays</h1>
<p class="text-secondary">
  National and Victorian public holidays for Melbourne planning.
</p>

<form action="/holidays" method="get" class="d-flex align-items-end gap-3 mb-3">
  <div>
    <label for="year" class="form-label">Year</label>
    <input
      id="year"
      name="year"
      type="number"
      min="2000"
      max="2100"
      step="1"
      value="<%= year %>"
      class="form-control"
      required
    />
  </div>

  <button class="btn btn-outline-dark" type="submit">View year</button>
</form>

<form action="/holidays/refresh?year=<%= year %>" method="post" class="mb-4">
  <button class="btn btn-dark" type="submit">
    Refresh <%= year %> holidays
  </button>
</form>

<% if (errorMessage) { %>
  <div class="alert alert-danger" role="alert">
    <%= errorMessage %>
  </div>
<% } %>

<% if (retrievedLabel) { %>
  <p>
    Last successful retrieval: <strong><%= retrievedLabel %></strong>
    <span class="badge <%= stale ? 'text-bg-warning' : 'text-bg-success' %>">
      <%= stale ? "Refresh needed" : "Within refresh interval" %>
    </span>
  </p>
<% } %>

<% if (!available) { %>
  <div class="alert alert-secondary">
    No saved holiday calendar exists for <%= year %>.
    Select Refresh to retrieve it.
  </div>
<% } else { %>
  <div class="table-responsive bg-white border rounded">
    <table class="table table-striped mb-0">
      <caption class="visually-hidden">
        Provider-listed Victorian public holidays for <%= year %>
      </caption>

      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Holiday</th>
          <th scope="col">Coverage</th>
        </tr>
      </thead>

      <tbody>
        <% for (const holiday of holidays) { %>
          <tr>
            <td><%= holiday.date %></td>
            <th scope="row"><%= holiday.name %></th>
            <td><%= holiday.scope %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

<p class="small text-secondary mt-3">
  Calendars are reused for 24 hours. School holidays and local exceptions
  are managed separately. These dates are planning context and do not
  determine the restaurant's opening hours.
</p>

<p class="small">
  Holiday data:
  <a href="https://github.com/nager/Nager.Date" target="_blank" rel="noopener noreferrer">
    Nager.Date
  </a>
</p>

<%- include("../partials/footer") %>