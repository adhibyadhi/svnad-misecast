<%- include("../partials/header") %>

<a href="/reservations" class="d-inline-flex align-items-center gap-2 text-decoration-none fw-semibold mb-4">← Back to reservations</a>

<header class="mc-page-header">
  <p class="mc-eyebrow">Reservation snapshot</p>
  <h1 class="display-6 fw-bold mc-page-title mb-2">Edit reservation totals</h1>
  <p class="mc-page-copy mb-0"><strong><%= form.date %></strong> · <%= form.service_period %></p>
</header>

<% if (errorMessage) { %>
  <div class="alert alert-danger mb-4" role="alert">
    <p class="mb-2"><%= errorMessage %></p>
    <a class="alert-link" href="/reservations/<%= form.id %>/edit">Reload latest values and discard these unsaved edits</a>
  </div>
<% } %>

<% if (form.is_synthetic) { %>
  <div class="alert alert-info mb-4">
    <strong>Synthetic record:</strong> editing these totals keeps that designation.
  </div>
<% } %>

<form method="post" action="/reservations/<%= form.id %>/edit">
  <input type="hidden" name="revision" value="<%= form.revision %>" />

  <div class="row g-4 align-items-start">
    <div class="col-lg-8">
      <section class="card" aria-labelledby="reservation-totals-heading">
        <div class="card-header px-4 py-3">
          <h2 id="reservation-totals-heading" class="h5 fw-bold mb-1">Service totals</h2>
          <p class="small text-secondary mb-0">Update the snapshot values that have changed.</p>
        </div>
        <div class="card-body p-4">
          <div class="row g-3">
            <%
              const numberFields = [
                ["bookings_count", "Booking groups", false],
                ["reserved_covers", "Reserved covers", false],
                ["cancelled_covers", "Cancelled covers", false],
                ["confirmed_covers", "Confirmed covers", true],
              ];
            %>
            <% for (const [name, label, required] of numberFields) { %>
              <div class="col-sm-6">
                <label for="<%= name %>" class="form-label"><%= label %><%= required ? " *" : "" %></label>
                <input id="<%= name %>" class="form-control" type="number" name="<%= name %>" min="0" step="1" value="<%= form[name] %>" <% if (required) { %>required<% } %> />
              </div>
            <% } %>
          </div>
        </div>
      </section>
    </div>

    <div class="col-lg-4">
      <aside class="card position-sticky" style="top: 1.5rem;" aria-labelledby="reservation-save-heading">
        <div class="card-body p-4">
          <span class="mc-icon mb-3" aria-hidden="true">✓</span>
          <h2 id="reservation-save-heading" class="h5 fw-bold">Save snapshot</h2>
          <p class="small text-secondary">
            Review every total before saving. The snapshot will use today's Melbourne date.
            Leave optional values blank when unknown.
          </p>
          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a href="/reservations" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</form>

<%- include("../partials/footer") %>
