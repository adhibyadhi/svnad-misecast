<%- include("../partials/header") %>

<h1 class="h2 mb-2">Reservations</h1>

<p class="text-secondary mb-4">
  Record reservation totals for a date and service period.
  Covers means people; bookings means reservation groups.
</p>

<% if (errorMessage) { %>
  <div class="alert alert-danger" role="alert">
    <%= errorMessage %>
  </div>
<% } %>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h5 mb-3">Add forecast reservation totals</h2>

    <form method="post" action="/reservations">
      <div class="row g-3">
        <div class="col-md-6">
          <label for="reservation-date" class="form-label">
            Date
          </label>

          <input
            id="reservation-date"
            class="form-control"
            type="date"
            name="date"
            min="<%= overview.today %>"
            value="<%= form.date ?? overview.today %>"
            required
          />
        </div>

        <div class="col-md-6">
          <label for="service-period" class="form-label">
            Service period
          </label>

          <input
            id="service-period"
            class="form-control"
            name="service_period"
            list="service-period-options"
            maxlength="80"
            value="<%= form.service_period ?? '' %>"
            aria-describedby="service-period-help"
            required
          />

          <datalist id="service-period-options">
            <% for (const servicePeriod of overview.servicePeriods) { %>
              <option value="<%= servicePeriod %>"></option>
            <% } %>
          </datalist>

          <div id="service-period-help" class="form-text">
            Use the exact service label from your sales data,
            including capitalisation.
          </div>
        </div>

        <%
          const numberFields = [
            ["bookings_count", "Booking groups", false],
            ["reserved_covers", "Reserved covers before cancellations", false],
            ["cancelled_covers", "Cancelled covers", false],
            ["confirmed_covers", "Confirmed covers", true],
          ];
        %>

        <% for (const [name, label, required] of numberFields) { %>
          <div class="col-md-6">
            <label for="<%= name %>" class="form-label">
              <%= label %><%= required ? " (required)" : "" %>
            </label>

            <input
              id="<%= name %>"
              class="form-control"
              type="number"
              name="<%= name %>"
              min="0"
              step="1"
              value="<%= form[name] ?? '' %>"
              <% if (required) { %>required<% } %>
            />
          </div>
        <% } %>
      </div>

      <p class="small text-secondary mt-3">
        Leave optional values blank when unknown. Enter 0 only when
        you have confirmed there are none. Saved entries are marked
        as real data with today's snapshot date.
      </p>

      <button type="submit" class="btn btn-primary">
        Save reservation totals
      </button>
    </form>
  </div>
</div>

<h2 class="h4 mb-3">Next 14 days</h2>

<% if (overview.rows.length === 0) { %>
  <div class="alert alert-info">
    No forecast reservation records are saved for this date range.
    This does not mean there are zero reservations.
  </div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-striped align-middle mb-0">
        <caption class="px-3">
          Saved forecast reservation totals.
          A dash indicates an unknown value.
        </caption>

        <thead class="table-light">
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Service</th>
            <th scope="col">Bookings</th>
            <th scope="col">Reserved</th>
            <th scope="col">Cancelled</th>
            <th scope="col">Confirmed</th>
            <th scope="col">Snapshot</th>
            <th scope="col">Source</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% for (const row of overview.rows) { %>
            <tr>
              <td class="text-nowrap"><%= row.date %></td>
              <td><%= row.service_period %></td>
              <td><%= row.bookings_count ?? "—" %></td>
              <td><%= row.reserved_covers ?? "—" %></td>
              <td><%= row.cancelled_covers ?? "—" %></td>
              <td class="fw-semibold">
                <%= row.confirmed_covers ?? "—" %>
              </td>
              <td class="text-nowrap">
                <%= row.data_snapshot_date ?? "—" %>
              </td>
              <td><%= row.is_synthetic ? "Synthetic" : "Real" %></td>
              <td>
                <a
                  class="btn btn-sm btn-outline-primary"
                  href="/reservations/<%= row._id %>/edit"
                >
                  Edit
                </a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include("../partials/footer") %>