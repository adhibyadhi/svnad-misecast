<%- include("partials/header", { title: "Menu" }) %>

  <!--
  Styles are scoped with the mc- prefix so they
  cannot affect the rest of the site.

  Font family is inherited from the site stylesheet
  so this page matches the rest of MiseCast.
-->
  <style>
    .mc-menu {
      --mc-ink: #19231f;
      --mc-green: #396d54;
      --mc-green-dark: #2c5742;
      --mc-green-soft: #eaf1ec;
      --mc-gold: #d8b05e;
      --mc-muted: #5f6b65;
      --mc-line: rgba(25, 35, 31, 0.1);
      --mc-radius: 24px;

      color: var(--mc-ink);
      padding-bottom: 80px;
    }

    /* Page heading */

    .mc-menu__eyebrow {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--mc-green);
      margin-bottom: 14px;
    }

    .mc-menu__title {
      font-size: clamp(2.4rem, 4.4vw, 3.4rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.04;
      margin-bottom: 18px;
    }

    .mc-menu__lead {
      font-size: 1.12rem;
      line-height: 1.6;
      color: var(--mc-muted);
      max-width: 620px;
      margin-bottom: 0;
    }

    /* Cards */

    .mc-card {
      background-color: #ffffff;
      border: 1px solid var(--mc-line);
      border-radius: var(--mc-radius);
      padding: 32px;
    }

    /* Summary statistics */

    .mc-stat {
      height: 100%;
    }

    .mc-stat__label {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--mc-muted);
      margin-bottom: 14px;
    }

    .mc-stat__value {
      font-size: 2.5rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1;
      margin: 0;
    }

    .mc-stat__unit {
      font-size: 1rem;
      font-weight: 600;
      color: var(--mc-muted);
      margin-left: 4px;
    }

    .mc-stat--dark {
      background-color: var(--mc-ink);
      border-color: var(--mc-ink);
      color: #ffffff;
    }

    .mc-stat--dark .mc-stat__label,
    .mc-stat--dark .mc-stat__unit {
      color: rgba(255, 255, 255, 0.6);
    }

    /* Category sections */

    .mc-group+.mc-group {
      margin-top: 28px;
    }

    .mc-group__header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;

      padding-bottom: 20px;
      margin-bottom: 4px;
      border-bottom: 1px solid var(--mc-line);
    }

    .mc-group__label {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin: 0;
    }

    .mc-group__count {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--mc-muted);
    }

    /* Menu rows */

    .mc-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;

      padding: 20px 0;
      border-bottom: 1px solid var(--mc-line);
    }

    .mc-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .mc-item__name {
      font-size: 1.08rem;
      font-weight: 700;
      margin: 0 0 4px;
    }

    .mc-item__id {
      font-size: 0.85rem;
      color: var(--mc-muted);
      letter-spacing: 0.04em;
    }

    .mc-item__price {
      font-size: 1.2rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    /* Notices */

    .mc-notice {
      border-radius: 16px;
      padding: 18px 22px;
      font-size: 0.98rem;
      line-height: 1.55;
    }

    .mc-notice--info {
      background-color: var(--mc-green-soft);
      color: var(--mc-green-dark);
    }

    .mc-notice--warning {
      background-color: rgba(216, 176, 94, 0.18);
      color: #7a5a14;
    }

    .mc-notice a {
      color: inherit;
      font-weight: 700;
    }

    .mc-footnote {
      font-size: 0.9rem;
      line-height: 1.6;
      color: var(--mc-muted);
      max-width: 640px;
      margin: 24px 0 0;
    }
  </style>


  <section class="mc-menu">

    <!-- Page heading -->
    <header class="mb-5">

      <p class="mc-menu__eyebrow">
        Menu catalogue
      </p>

      <h1 class="mc-menu__title">
        What the kitchen sells.
      </h1>

      <p class="mc-menu__lead">
        The <%= expectedItemCount %> items every forecast
          is built from, grouped by category with the
          current selling price.
      </p>

    </header>


    <!--
    Warning shown when the item count is wrong.
  -->
    <% if (error) { %>

      <div class="mc-notice mc-notice--warning mb-4">
        <%= error %>
      </div>

      <% } %>


        <!--
    Summary.
  -->
        <div class="row g-4 mb-5">

          <div class="col-md-6 col-xl-3">

            <div class="mc-card mc-stat mc-stat--dark">

              <p class="mc-stat__label">
                Menu items
              </p>

              <p class="mc-stat__value">

                <%= totals.itemCount %>

                  <span class="mc-stat__unit">
                    of <%= expectedItemCount %>
                  </span>

              </p>

            </div>

          </div>


          <div class="col-md-6 col-xl-3">

            <div class="mc-card mc-stat">

              <p class="mc-stat__label">
                Categories
              </p>

              <p class="mc-stat__value">
                <%= totals.categoryCount %>
              </p>

            </div>

          </div>


          <div class="col-md-6 col-xl-3">

            <div class="mc-card mc-stat">

              <p class="mc-stat__label">
                Lowest price
              </p>

              <p class="mc-stat__value">
                $<%= totals.lowestPrice %>
              </p>

            </div>

          </div>


          <div class="col-md-6 col-xl-3">

            <div class="mc-card mc-stat">

              <p class="mc-stat__label">
                Highest price
              </p>

              <p class="mc-stat__value">
                $<%= totals.highestPrice %>
              </p>

            </div>

          </div>

        </div>


        <!--
    Nothing imported yet.
  -->
        <% if (totals.itemCount===0) { %>

          <div class="mc-notice mc-notice--info">

            No menu items were found. Import menu.csv from the

            <a href="/import">
              imports page
            </a>

            to load the <%= expectedItemCount %> items.

          </div>

          <% } else { %>


            <!--
      One card for each category.
    -->
            <% groups.forEach(group=> { %>

              <div class="mc-card mc-group">

                <div class="mc-group__header">

                  <h2 class="mc-group__label">
                    <%= group.label %>
                  </h2>

                  <span class="mc-group__count">
                    <%= group.itemCount %> item<%= group.itemCount===1 ? "" : "s" %>
                  </span>

                </div>


                <% group.items.forEach(item=> { %>

                  <div class="mc-item">

                    <div>

                      <p class="mc-item__name">
                        <%= item.name %>
                      </p>



                    </div>


                    <span class="mc-item__price">
                      $<%= item.price %>
                    </span>

                  </div>

                  <% }) %>

              </div>

              <% }) %>


                <p class="mc-footnote">

                  Prices are the standard selling price before any
                  promotion discount. Discounted prices are applied
                  when a prediction is prepared.

                </p>

                <% } %>

  </section>