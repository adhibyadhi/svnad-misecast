<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> | MiseCast</title>

    <link
      rel="stylesheet"
      href="/vendor/bootstrap/css/bootstrap.min.css"
    />
  </head>

  <body class="bg-light d-flex flex-column min-vh-100">
    <a
      class="visually-hidden-focusable position-absolute top-0 start-0 p-3 bg-white"
      href="#main-content"
    >
      Skip to main content
    </a>

    <nav class="navbar navbar-dark bg-dark" aria-label="Main navigation">
      <div class="container">
        <a class="navbar-brand fw-semibold" href="/">MiseCast</a>

        <div class="d-flex gap-3">
          <a
            class="nav-link text-white"
            href="/holidays"
            <% if (currentPath === "/holidays" || currentPath.startsWith("/holidays/")) { %>aria-current="page"<% } %>
          >
            Holidays
          </a>
          <a
  class="nav-link text-white"
  href="/events"
  <% if (currentPath === "/events" || currentPath.startsWith("/events/")) { %>aria-current="page"<% } %>
>
  Events
</a>
<a
  class="nav-link text-white"
  href="/context"
  <% if (currentPath === "/context" || currentPath.startsWith("/context/")) { %>aria-current="page"<% } %>
>
  Context
</a>

<a
  class="nav-link text-white"
  href="/reservations"
  <% if (currentPath === "/reservations" || currentPath.startsWith("/reservations/")) { %>aria-current="page"<% } %>
>
  Reservations
</a>
<a
  class="nav-link text-white"
  href="/imports"
  <% if (currentPath === "/imports" || currentPath.startsWith("/imports/")) { %>aria-current="page"<% } %>
>
  Imports
</a>
<a
  class="nav-link text-white"
  href="/promotions"
  <% if (currentPath === "/promotions" || currentPath.startsWith("/promotions/")) { %>aria-current="page"<% } %>
>
  Promotions
</a>

          <a
            class="nav-link text-white"
            href="/"
            <% if (currentPath === "/") { %>aria-current="page"<% } %>
          >
            Home
          </a>

          <a
            class="nav-link text-white"
            href="/menus"
            <% if (
              currentPath === "/menus" ||
              currentPath.startsWith("/menus/")
            ) { %>
              aria-current="page"
            <% } %>
          >
            Menu
          </a>

          <a
            class="nav-link text-white"
            href="/weather"
            <% if (
              currentPath === "/weather" ||
              currentPath.startsWith("/weather/")
            ) { %>
              aria-current="page"
            <% } %>
          >
            Weather
          </a>
        </div>
      </div>
    </nav>

    <main
      id="main-content"
      class="container py-5 flex-grow-1"
      tabindex="-1"
    >