<%- include("partials/header", { title: "Prediction" }) %>

<div class="page-card">

  <h1 class="mb-3">
    Sales Prediction
  </h1>

  <p class="text-muted">
    Select a future date range of up to 7 days.
  </p>


  <!--
    Display validation errors.
  -->
  <% if (error) { %>

    <div class="alert alert-danger">
      <%= error %>
    </div>

  <% } %>


  <!--
    Display success message.
  -->
  <% if (success) { %>

    <div class="alert alert-success">
      <%= success %>
    </div>

  <% } %>


  <!--
    Prediction date form.
  -->
  <form action="/prediction" method="POST">

    <div class="row">

      <!-- Start Date -->
      <div class="col-md-6 mb-3">

        <label
          for="startDate"
          class="form-label"
        >
          Start Date
        </label>

        <input
          type="date"
          class="form-control"
          id="startDate"
          name="startDate"
          min="<%= minimumDate %>"
          max="<%= maximumDate %>"
          value="<%= startDate || "" %>"
          required
        >

      </div>


      <!-- End Date -->
      <div class="col-md-6 mb-3">

        <label
          for="endDate"
          class="form-label"
        >
          End Date
        </label>

        <input
          type="date"
          class="form-control"
          id="endDate"
          name="endDate"
          min="<%= minimumDate %>"
          max="<%= maximumDate %>"
          value="<%= endDate || "" %>"
          required
        >

      </div>

    </div>


    <p class="text-muted">

      Predictions are limited to 7 days
      and must be within the available
      weather forecast period.

    </p>


    <button
      type="submit"
      class="btn btn-primary"
    >
      Generate Prediction
    </button>

  </form>


  <!--
    Display the dates that will eventually
    be sent to the ML model one day at a time.
  -->
  <% if (dates && dates.length > 0) { %>

    <hr class="my-4">

    <h4>
      Prediction Dates
    </h4>

    <ul class="list-group mb-4">

      <% dates.forEach(date => { %>

        <li class="list-group-item">
          <%= date %>
        </li>

      <% }) %>

    </ul>

  <% } %>


  <!--
    Preview the ML inputs.

    These objects contain:
    - menu names
    - discounted prices
    - reservations
    - weather
    - public holiday
    - event count
  -->
  <% if (mlInputs && mlInputs.length > 0) { %>

    <hr class="my-4">


    <h3 class="mb-3">
      ML Input Preview
    </h3>


    <p class="text-muted">
      One ML input object will be created for each day.
    </p>


    <% mlInputs.forEach(input => { %>

      <div class="card mb-4">

        <!-- Date -->
        <div class="card-header">

          <strong>

            <%= new Date(input.date).toISOString().slice(0, 10) %>

          </strong>

        </div>


        <div class="card-body">

          <!-- Reservation -->
          <p>

            <strong>
              Total Reservations:
            </strong>

            <%= input.total_reservation %>

          </p>


          <!-- External data -->
          <div class="row mb-4">

            <!-- Temperature -->
            <div class="col-md-3 mb-3">

              <strong>
                Average Temperature
              </strong>

              <div>
                <%= input.avg_temp %> °C
              </div>

            </div>


            <!-- Rain -->
            <div class="col-md-3 mb-3">

              <strong>
                Rain
              </strong>

              <div>

                <% if (input.rain) { %>

                  Yes

                <% } else { %>

                  No

                <% } %>

              </div>

            </div>


            <!-- Public Holiday -->
            <div class="col-md-3 mb-3">

              <strong>
                Public Holiday
              </strong>

              <div>

                <% if (input.public_holiday) { %>

                  Yes

                <% } else { %>

                  No

                <% } %>

              </div>

            </div>


            <!-- Events -->
            <div class="col-md-3 mb-3">

              <strong>
                Events
              </strong>

              <div>
                <%= input.num_of_event %>
              </div>

            </div>

          </div>


          <!-- Menu information -->
          <h5>
            Menu Input
          </h5>


          <div class="table-responsive">

            <table class="table table-bordered table-striped table-sm">

              <thead>

                <tr>

                  <th>
                    Menu
                  </th>

                  <th>
                    Price After Discount
                  </th>

                </tr>

              </thead>


              <tbody>

                <% for (let i = 1; i <= 15; i++) { %>

                  <tr>

                    <td>

                      <%= input[`menu_${i}`] %>

                    </td>


                    <td>

                      $<%= input[`menu_${i}_price_after_discount`].toFixed(2) %>

                    </td>

                  </tr>

                <% } %>

              </tbody>

            </table>

          </div>


          <div class="alert alert-success mt-3">

            ML input is complete and ready
            to be sent to the prediction model.

          </div>

        </div>

      </div>

    <% }) %>

  <% } %>

</div>


<%- include("partials/footer") %>