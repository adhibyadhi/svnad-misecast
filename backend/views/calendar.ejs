<%- include("partials/header", { title: "Calendar" }) %>

<!--
  Styles are scoped with the mc- prefix so they
  cannot affect the rest of the site.
-->
<style>
  .mc-calendar-page {
    --mc-ink: #19231f;
    --mc-green: #396d54;
    --mc-green-dark: #2c5742;
    --mc-green-soft: #eaf1ec;
    --mc-gold: #d8b05e;
    --mc-gold-soft: rgba(216, 176, 94, 0.2);
    --mc-violet: #5b4b8a;
    --mc-violet-soft: #ece9f6;
    --mc-sky: #35618b;
    --mc-sky-soft: #e7eff7;
    --mc-muted: #5f6b65;
    --mc-line: rgba(25, 35, 31, 0.1);
    --mc-radius: 24px;

    color: var(--mc-ink);
    padding-bottom: 80px;
  }

  /* Page heading */

  .mc-page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;

    margin-bottom: 36px;
  }

  .mc-flag {
    display: inline-block;
    padding: 8px 18px;
    margin-bottom: 18px;

    border-radius: 999px;
    background-color: var(--mc-gold-soft);
    color: #7a5a14;

    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .mc-title {
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
    margin: 0 0 14px;
  }

  .mc-lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--mc-muted);
    max-width: 560px;
    margin: 0;
  }

  /* Month controls */

  .mc-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mc-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 46px;
    height: 46px;

    border: 1px solid var(--mc-line);
    border-radius: 14px;
    background-color: #ffffff;

    color: var(--mc-ink);
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .mc-step:hover {
    background-color: var(--mc-green-soft);
    color: var(--mc-green-dark);
  }

  .mc-today-link {
    padding: 12px 22px;

    border: 1px solid var(--mc-green);
    border-radius: 14px;
    background-color: var(--mc-green);

    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }

  .mc-today-link:hover {
    background-color: var(--mc-green-dark);
    color: #ffffff;
  }

  /* Notice */

  .mc-notice {
    border-radius: 16px;
    padding: 18px 22px;
    margin-bottom: 28px;

    background-color: var(--mc-gold-soft);
    color: #7a5a14;

    font-size: 0.98rem;
    line-height: 1.55;
  }

  /* Layout */

  .mc-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 1199px) {
    .mc-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .mc-panel {
    background-color: #ffffff;
    border: 1px solid var(--mc-line);
    border-radius: var(--mc-radius);
    padding: 26px;
  }

  .mc-panel__title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--mc-muted);
    margin-bottom: 18px;
  }

  /* Filters */

  .mc-filter {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    cursor: pointer;
    font-weight: 600;
  }

  .mc-filter input {
    width: 18px;
    height: 18px;
    accent-color: var(--mc-green);
    cursor: pointer;
  }

  .mc-swatch {
    width: 14px;
    height: 14px;
    border-radius: 5px;
    flex-shrink: 0;
  }

  .mc-swatch--holiday {
    background-color: var(--mc-gold);
  }

  .mc-swatch--event {
    background-color: var(--mc-violet);
  }

  .mc-swatch--reservation {
    background-color: var(--mc-green);
  }

  .mc-swatch--weather {
    background-color: var(--mc-sky);
  }

  /* Month totals */

  .mc-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    font-size: 0.95rem;
  }

  .mc-total__label {
    color: var(--mc-muted);
  }

  .mc-total__value {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* Calendar shell */

  .mc-calendar {
    background-color: #ffffff;
    border: 1px solid var(--mc-line);
    border-radius: var(--mc-radius);
    overflow: hidden;
  }

  .mc-calendar__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    padding: 22px 28px;
    background-color: #fbfbf9;
    border-bottom: 1px solid var(--mc-line);
  }

  .mc-calendar__month {
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .mc-calendar__scroll {
    overflow-x: auto;
  }

  .mc-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(150px, 1fr));
    min-width: 1050px;
  }

  .mc-grid__weekday {
    padding: 16px 12px;

    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mc-muted);

    border-bottom: 1px solid var(--mc-line);
    border-right: 1px solid var(--mc-line);
  }

  .mc-grid__weekday:nth-child(7n) {
    border-right: none;
  }

  /* Day cells */

  .mc-day {
    min-height: 150px;
    padding: 14px;

    border-right: 1px solid var(--mc-line);
    border-bottom: 1px solid var(--mc-line);
  }

  .mc-day:nth-child(7n) {
    border-right: none;
  }

  .mc-day--outside {
    background-color: #fcfcfa;
  }

  .mc-day--outside .mc-day__number {
    color: rgba(95, 107, 101, 0.45);
  }

  .mc-day--weekend {
    background-color: #fbfbf9;
  }

  .mc-day__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 30px;
    height: 30px;
    padding: 0 8px;

    border-radius: 999px;

    font-size: 1rem;
    font-weight: 700;
  }

  .mc-day--today .mc-day__number {
    background-color: var(--mc-ink);
    color: #ffffff;
  }

  .mc-day__chips {
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Chips */

  .mc-chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;

    padding: 6px 10px;
    border-radius: 9px;

    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .mc-chip__text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mc-chip__count {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .mc-chip--holiday {
    background-color: var(--mc-gold-soft);
    color: #7a5a14;
  }

  .mc-chip--event {
    background-color: var(--mc-violet-soft);
    color: var(--mc-violet);
  }

  .mc-chip--reservation {
    background-color: var(--mc-green-soft);
    color: var(--mc-green-dark);
  }

  .mc-chip--weather {
    background-color: var(--mc-sky-soft);
    color: var(--mc-sky);
  }

  /* Filter switching */

  .mc-calendar-page.hide-holiday .mc-chip--holiday,
  .mc-calendar-page.hide-event .mc-chip--event,
  .mc-calendar-page.hide-reservation .mc-chip--reservation,
  .mc-calendar-page.hide-weather .mc-chip--weather {
    display: none;
  }
</style>


<section class="mc-calendar-page" id="calendarPage">

  <!-- Page heading -->
  <div class="mc-page-head">

    <div>

      <% if (simulated) { %>

        <span class="mc-flag">
          Simulation mode
        </span>

      <% } %>

      <h1 class="mc-title">
        Calendar
      </h1>

      <p class="mc-lead">
        Public holidays, local events, bookings and
        weather on the days they land.
      </p>

    </div>


    <div class="mc-controls">

      <a
        class="mc-step"
        href="<%= previousLink %>"
        aria-label="Previous month"
      >
        &larr;
      </a>

      <a
        class="mc-step"
        href="<%= nextLink %>"
        aria-label="Next month"
      >
        &rarr;
      </a>

      <a
        class="mc-today-link"
        href="<%= todayLink %>"
      >
        This month
      </a>

    </div>

  </div>


  <% if (warning) { %>

    <div class="mc-notice">
      <%= warning %>
    </div>

  <% } %>


  <div class="mc-layout">

    <!-- Filters and totals -->
    <aside>

      <div class="mc-panel mb-4">

        <p class="mc-panel__title">
          Filters
        </p>

        <label class="mc-filter">

          <input
            type="checkbox"
            data-filter="holiday"
            checked
          >

          <span class="mc-swatch mc-swatch--holiday"></span>

          Holidays

        </label>


        <label class="mc-filter">

          <input
            type="checkbox"
            data-filter="event"
            checked
          >

          <span class="mc-swatch mc-swatch--event"></span>

          Local events

        </label>


        <label class="mc-filter">

          <input
            type="checkbox"
            data-filter="reservation"
            checked
          >

          <span class="mc-swatch mc-swatch--reservation"></span>

          Reservations

        </label>


        <label class="mc-filter">

          <input
            type="checkbox"
            data-filter="weather"
            checked
          >

          <span class="mc-swatch mc-swatch--weather"></span>

          Weather

        </label>

      </div>


      <div class="mc-panel">

        <p class="mc-panel__title">
          This month
        </p>

        <div class="mc-total">

          <span class="mc-total__label">
            Public holidays
          </span>

          <span class="mc-total__value">
            <%= totals.holidayCount %>
          </span>

        </div>


        <div class="mc-total">

          <span class="mc-total__label">
            Local events
          </span>

          <span class="mc-total__value">
            <%= totals.eventCount %>
          </span>

        </div>


        <div class="mc-total">

          <span class="mc-total__label">
            Bookings
          </span>

          <span class="mc-total__value">
            <%= totals.reservationCount %>
          </span>

        </div>


        <div class="mc-total">

          <span class="mc-total__label">
            Guests
          </span>

          <span class="mc-total__value">
            <%= totals.guestCount %>
          </span>

        </div>

      </div>

    </aside>


    <!-- Month grid -->
    <div class="mc-calendar">

      <div class="mc-calendar__bar">

        <h2 class="mc-calendar__month">
          <%= monthLabel %> <%= yearLabel %>
        </h2>

      </div>


      <div class="mc-calendar__scroll">

        <div class="mc-grid">

          <% weekdayNames.forEach(weekday => { %>

            <div class="mc-grid__weekday">
              <%= weekday.slice(0, 3) %>
            </div>

          <% }) %>


          <% weeks.forEach(week => { %>

            <% week.forEach(day => { %>

              <div class="mc-day <%= day.inMonth ? "" : "mc-day--outside" %> <%= day.isToday ? "mc-day--today" : "" %> <%= day.inMonth && day.isWeekend ? "mc-day--weekend" : "" %>">

                <span class="mc-day__number">
                  <%= day.dayNumber %>
                </span>


                <% if (day.inMonth) { %>

                  <div class="mc-day__chips">

                    <% if (day.holidayName) { %>

                      <span class="mc-chip mc-chip--holiday">

                        <span class="mc-chip__text">
                          <%= day.holidayName %>
                        </span>

                      </span>

                    <% } %>


                    <% if (day.eventCount > 0) { %>

                      <span class="mc-chip mc-chip--event">

                        <span class="mc-chip__text">
                          Local event<%= day.eventCount === 1 ? "" : "s" %>
                        </span>

                        <span class="mc-chip__count">
                          <%= day.eventCount %>
                        </span>

                      </span>

                    <% } %>


                    <% if (day.reservationCount > 0) { %>

                      <span class="mc-chip mc-chip--reservation">

                        <span class="mc-chip__text">
                          <%= day.guestCount %> guests
                        </span>

                        <span class="mc-chip__count">
                          <%= day.reservationCount %>
                        </span>

                      </span>

                    <% } %>


                    <% if (day.temperature !== null) { %>

                      <span class="mc-chip mc-chip--weather">

                        <span class="mc-chip__text">
                          <%= day.temperature.toFixed(0) %>&deg;C<%= day.rain ? " · Rain" : "" %>
                        </span>

                      </span>

                    <% } %>

                  </div>

                <% } %>

              </div>

            <% }) %>

          <% }) %>

        </div>

      </div>

    </div>

  </div>


  <!--
    Filters hide or show chip types.
  -->
  <script>
    (function () {
      const page = document.getElementById("calendarPage");

      const checkboxes = page.querySelectorAll("[data-filter]");

      checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener("change", function () {
          const className = "hide-" + checkbox.getAttribute("data-filter");

          page.classList.toggle(className, !checkbox.checked);
        });
      });
    })();
  </script>

</section>
