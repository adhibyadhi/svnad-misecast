<%- include("../partials/header") %>

<% const money = new Intl.NumberFormat("en-AU", {
  style: "currency",
  currency: "AUD"
}); %>
<% const quantity = new Intl.NumberFormat("en-AU", {
  maximumFractionDigits: 3
}); %>

<section aria-labelledby="waste-heading">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-end mb-4">
    <div>
      <p class="text-secondary mb-2">Inventory control</p>
      <h1 id="waste-heading" class="display-6 fw-semibold mb-2">
        Waste report
      </h1>
      <p class="text-secondary mb-0">
        Estimated unsold portions are separated into recorded waste and unexplained loss.
      </p>
    </div>

    <form method="get" action="/waste" class="d-flex gap-2">
      <label class="visually-hidden" for="period">Reporting period</label>
      <select id="period" name="period" class="form-select" onchange="this.form.submit()">
        <option value="current" <%= period === "current" ? "selected" : "" %>>
          This month
        </option>
        <option value="previous" <%= period === "previous" ? "selected" : "" %>>
          Last month
        </option>
      </select>
    </form>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <p class="text-secondary small mb-2">Total estimated waste</p>
          <p class="h3 fw-semibold mb-1"><%= money.format(summary.totalWasteValueAud) %></p>
          <p class="small text-secondary mb-0">
            <%= summary.wastePercentOfPurchases === null
              ? "No sales in this period"
              : `${summary.wastePercentOfPurchases}% of estimated preparation cost` %>
          </p>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <p class="text-secondary small mb-2">Recorded waste</p>
          <p class="h3 fw-semibold mb-1"><%= money.format(summary.recordedWasteValueAud) %></p>
          <p class="small text-secondary mb-0">Logged by staff with a reason</p>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <p class="text-secondary small mb-2">Unexplained loss</p>
          <p class="h3 fw-semibold text-danger mb-1">
            <%= money.format(summary.unexplainedLossValueAud) %>
          </p>
          <p class="small text-secondary mb-0">Estimated unrecorded loss</p>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <p class="text-secondary small mb-2">Menu items checked</p>
          <p class="h3 fw-semibold mb-1"><%= summary.ingredientCount %></p>
          <p class="small text-secondary mb-0">Included in this report</p>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom p-3 p-md-4">
      <div class="d-flex flex-column flex-md-row gap-3 justify-content-between">
        <div>
          <h2 class="h5 mb-1">Waste by menu item</h2>
          <p class="small text-secondary mb-0">
            Estimates use actual sales from the newest model and an 8% preparation buffer.
          </p>
        </div>

        <div class="d-flex align-items-center gap-2">
          <label for="waste-search" class="visually-hidden">Search menu items</label>
          <input
            id="waste-search"
            type="search"
            class="form-control"
            placeholder="Search menu items"
            autocomplete="off"
          />
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-4">Menu item</th>
            <th scope="col">Prepared</th>
            <th scope="col">Sold</th>
            <th scope="col">Recorded waste</th>
            <th scope="col">Unexplained loss</th>
            <th scope="col">Variance</th>
            <th scope="col" class="text-end pe-4">Waste value</th>
          </tr>
        </thead>
        <tbody id="waste-table-body">
          <% if (rows.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center text-secondary py-5">
                No menu or sales data is available for this period.
              </td>
            </tr>
          <% } %>

          <% rows.forEach((row) => { %>
            <tr data-ingredient-name="<%= row.ingredientName.toLowerCase() %>">
              <th scope="row" class="ps-4 fw-semibold">
                <%= row.ingredientName %>
                <div class="small text-secondary fw-normal">
                  Period ending:
                  <%= row.lastCountedAt
                    ? new Date(row.lastCountedAt).toLocaleDateString("en-AU")
                    : "Not available" %>
                </div>
              </th>
              <td><%= quantity.format(row.expectedQuantity) %> <%= row.unit %></td>
              <td><%= quantity.format(row.actualCountQuantity) %> <%= row.unit %></td>
              <td>
                <%= quantity.format(row.recordedWasteQuantity) %> <%= row.unit %>
                <div class="small text-secondary">
                  <%= money.format(row.recordedWasteValueAud) %>
                </div>
              </td>
              <td>
                <%= quantity.format(row.unexplainedLossQuantity) %> <%= row.unit %>
                <div class="small text-secondary">
                  <%= money.format(row.unexplainedLossValueAud) %>
                </div>
              </td>
              <td>
                <% if (row.varianceQuantity < 0) { %>
                  <span class="badge text-bg-danger">
                    <%= quantity.format(row.varianceQuantity) %> <%= row.unit %>
                  </span>
                <% } else if (row.varianceQuantity > 0) { %>
                  <span class="badge text-bg-warning">
                    +<%= quantity.format(row.varianceQuantity) %> <%= row.unit %>
                  </span>
                <% } else { %>
                  <span class="badge text-bg-success">Matched</span>
                <% } %>
                <div class="small text-secondary mt-1">
                  <%= row.variancePercent === null
                    ? "N/A"
                    : `${row.variancePercent}%` %>
                </div>
              </td>
              <td class="text-end pe-4 fw-semibold">
                <%= money.format(row.totalWasteValueAud) %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="alert alert-light border mt-4 mb-0" role="note">
    <strong>Simulation note:</strong> the newest database does not yet store ingredient
    stocktakes. This report estimates menu-level waste from actual sales and an 8%
    preparation buffer; unexplained loss is not confirmed physical waste.
  </div>
</section>

<script>
  const wasteSearch = document.getElementById("waste-search");

  wasteSearch?.addEventListener("input", () => {
    const searchText = wasteSearch.value.trim().toLowerCase();

    document.querySelectorAll("#waste-table-body tr[data-ingredient-name]")
      .forEach((row) => {
        row.hidden = !row.dataset.ingredientName.includes(searchText);
      });
  });
</script>

<%- include("../partials/footer") %>
