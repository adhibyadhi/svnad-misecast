<%- include("../partials/header") %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
  <div>
    <h1 class="h2 mb-2">Nearby events</h1>
    <p class="text-secondary mb-0">
      Events within <%= context.radiusKm %> km of your configured
      restaurant location in Melbourne.
    </p>
  </div>

  <form method="post" action="/events/refresh">
    <button
      type="submit"
      class="btn btn-primary"
      <% if (!context.configured) { %>disabled<% } %>
    >
      Refresh events
    </button>
  </form>
</div>

<% if (errorMessage) { %>
  <div class="alert alert-danger" role="alert">
    <%= errorMessage %>
  </div>
<% } %>

<% if (!context.configured) { %>
  <div class="alert alert-warning" role="alert">
    The events connection needs an API key.
    Add TICKETMASTER_API_KEY to your .env file and restart the server.
  </div>
<% } %>

<% if (context.available) { %>
  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <% if (context.stale) { %>
          <span class="badge text-bg-warning">Refresh needed</span>
        <% } else { %>
          <span class="badge text-bg-success">Up to date</span>
        <% } %>

        <span class="text-secondary">
          <%= context.dateStart %> to <%= context.dateEnd %>
        </span>
      </div>

      <p class="mb-2">
        <strong>Last refreshed:</strong>
        <%= new Intl.DateTimeFormat("en-AU", {
          timeZone: restaurant.timezone,
          dateStyle: "medium",
          timeStyle: "short",
        }).format(new Date(context.retrievedAt)) %>
        (Melbourne time)
      </p>

      <p class="mb-0 text-secondary">
        <%= context.events.length %> events shown from
        <%= context.fetchedCount %> fetched listings.
        Refreshes reuse saved results for up to six hours.
      </p>
    </div>
  </div>

  <% if (context.stale) { %>
    <div class="alert alert-warning" role="status">
      These are previously saved results. Refresh before using them
      for upcoming service planning.
    </div>
  <% } %>

  <% if (context.truncated) { %>
    <div class="alert alert-warning" role="status">
      The search reached its page limit. Additional provider listings
      were not retrieved, so this list is incomplete.
    </div>
  <% } %>

  <% if (context.excludedCount > 0) { %>
    <p class="small text-secondary">
      <%= context.excludedCount %> listings were excluded because of
      their status, date, location, or missing required details.
    </p>
  <% } %>

  <% if (context.events.length === 0) { %>
    <div class="alert alert-info" role="status">
      No eligible events were found in the retrieved listings.
      Other events may still be happening nearby.
    </div>
  <% } else { %>
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
          <caption class="px-3">
            Nearby event listings. Dates and start times are local
            to Melbourne; distances are approximate straight-line distances.
          </caption>

          <thead class="table-light">
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Start</th>
              <th scope="col">Event</th>
              <th scope="col">Venue</th>
              <th scope="col">Type</th>
              <th scope="col" class="text-end">Distance</th>
            </tr>
          </thead>

          <tbody>
            <% for (const event of context.events) { %>
              <tr>
                <td class="text-nowrap">
                  <%= event.event_date %>
                </td>

                <td class="text-nowrap">
                  <%= event.start_time
                    ? event.start_time.slice(0, 5)
                    : "Time unavailable" %>
                </td>

                <th scope="row" class="fw-normal">
                  <%= event.event_name %>
                </th>

                <td>
                  <%= event.venue_name ?? "Unknown venue" %>
                </td>

                <td>
                  <%= event.event_type ?? "Unspecified" %>
                </td>

                <td class="text-end text-nowrap">
                  <% if (event.distance_from_restaurant_km != null) { %>
                    <%= Number(
                      event.distance_from_restaurant_km
                    ).toFixed(1) %> km
                  <% } else { %>
                    —
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

<% } else { %>
  <div class="card shadow-sm">
    <div class="card-body">
      <h2 class="h5">No saved events yet</h2>
      <p class="mb-0 text-secondary">
        Refresh events to retrieve the next 14 days of nearby listings.
      </p>
    </div>
  </div>
<% } %>

<p class="small text-secondary mt-4">
  Event data provided by
  <a href="https://www.ticketmaster.com.au/">Ticketmaster</a>.
  Listings do not cover every local event. Attendance and expected
  restaurant demand have not been estimated.
</p>

<%- include("../partials/footer") %>