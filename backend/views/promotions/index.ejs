<%- include("../partials/header") %>

<h1 class="h2 mb-2">Promotions</h1>

<p class="text-secondary mb-4">
  Schedule a discount for one menu variant, date, and service period.
</p>

<% if (errorMessage) { %>
  <div class="alert alert-danger" role="alert">
    <%= errorMessage %>
  </div>
<% } %>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h5 mb-3">Add a promotion</h2>

    <% if (overview.variants.length === 0) { %>
      <div class="alert alert-info mb-0">
        Add an active menu item and variant through
        <a href="/menus" class="alert-link">Menu</a>
        before creating a promotion.
      </div>
    <% } else { %>
      <form method="post" action="/promotions">
        <div class="row g-3">
          <div class="col-md-6">
            <label for="promotion-date" class="form-label">
              Date
            </label>

            <input
              id="promotion-date"
              class="form-control"
              type="date"
              name="promotion_date"
              min="<%= overview.today %>"
              value="<%= form.promotion_date ?? overview.today %>"
              required
            />
          </div>

          <div class="col-md-6">
            <label for="promotion-service" class="form-label">
              Service period
            </label>

            <input
              id="promotion-service"
              class="form-control"
              name="service_period"
              maxlength="80"
              value="<%= form.service_period ?? '' %>"
              aria-describedby="promotion-service-help"
              required
            />

            <div id="promotion-service-help" class="form-text">
              Use the exact service label from your sales data,
              including capitalisation.
            </div>
          </div>

          <div class="col-md-8">
            <label for="promotion-variant" class="form-label">
              Menu variant
            </label>

            <select
              id="promotion-variant"
              class="form-select"
              name="menu_variant_id"
              required
            >
              <option value="">Choose a menu variant</option>

              <% for (const variant of overview.variants) { %>
                <option
                  value="<%= variant.menu_variant_id %>"
                  <% if (form.menu_variant_id === variant.menu_variant_id) { %>selected<% } %>
                >
                  <%= variant.menu_variant_name %>
                  (<%= variant.menu_variant_id %>)
                </option>
              <% } %>
            </select>
          </div>

          <div class="col-md-4">
            <label for="promotion-discount" class="form-label">
              Discount (%)
            </label>

            <input
              id="promotion-discount"
              class="form-control"
              type="number"
              name="discount_pct"
              min="0.01"
              max="100"
              step="0.01"
              value="<%= form.discount_pct ?? '' %>"
              required
            />
          </div>
        </div>

        <p class="small text-secondary mt-3">
          Saving records a planned discount. It does not change the
          menu's base price or apply a discount in your POS.
        </p>

        <button type="submit" class="btn btn-primary">
          Save promotion
        </button>
      </form>
    <% } %>
  </div>
</div>

<h2 class="h4 mb-3">Upcoming promotions</h2>

<% if (overview.promotions.length === 0) { %>
  <div class="alert alert-info">
    No upcoming promotions are saved.
  </div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-striped align-middle mb-0">
        <caption class="px-3">
          Up to 100 upcoming promotions, ordered by date.
        </caption>

        <thead class="table-light">
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Service</th>
            <th scope="col">Menu variant</th>
            <th scope="col">Discount</th>
            <th scope="col">Source</th>
          </tr>
        </thead>

        <tbody>
          <% for (const promotion of overview.promotions) { %>
            <tr>
              <td class="text-nowrap">
                <%= promotion.promotion_date %>
              </td>

              <td><%= promotion.service_period %></td>

              <td>
                <%= promotion.menu_variant_name
                  ?? promotion.menu_variant_id %>
              </td>

              <td>
                <%= promotion.discount_pct == null
                  ? "Unknown"
                  : `${promotion.discount_pct}%` %>
              </td>

              <td>
                <%= promotion.is_synthetic ? "Synthetic" : "Real" %>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include("../partials/footer") %>